APP_ENV=development
LOG_LEVEL=INFO

# LLM (required — agents use LLM + MCP tools for validation)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1
LLM_API_KEY=
LLM_BASE_URL=https://litellm-proxy.greenground-f83f22ea.eastus.azurecontainerapps.io/v1
USE_LLM_AGENTS=true

# Atlassian Rovo MCP
JIRA_MCP_URL=https://mcp.atlassian.com/v1/mcp
JIRA_EMAIL=
JIRA_API_TOKEN=

# Jira validation
JIRA_ALLOWED_RELEASE_STATUSES=Resolved,Closed
# Optional: set if auto-discovery fails (from getAccessibleAtlassianResources)
JIRA_CLOUD_ID=

# GitHub MCP
GITHUB_PERSONAL_ACCESS_TOKEN=
# Transport: http (remote) or stdio (local Docker binary)
GITHUB_MCP_TRANSPORT=http
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# For stdio transport (Docker official server)
GITHUB_MCP_DOCKER_IMAGE=ghcr.io/github/github-mcp-server
GITHUB_MCP_TOOLSETS=pull_requests,issues

# Release CI/CD (post-merge build)
# stub = local demo ID; github_actions = observe or dispatch a workflow
CI_PROVIDER=stub
# observe = find a push run (inputs blank). dispatch = start a run and pass portal inputs.
CI_TRIGGER_MODE=observe
GITHUB_ACTIONS_WORKFLOW=release-build.yml
GITHUB_ACTIONS_POLL_INTERVAL_SECONDS=10
GITHUB_ACTIONS_POLL_TIMEOUT_SECONDS=1800
GITHUB_ACTIONS_DISCOVER_TIMEOUT_SECONDS=120
# If the PR repo has no workflow, complete with a stub BUILD-* id instead of BUILD_FAILED
CI_FALLBACK_TO_STUB=false

# QA development/testing overrides (only when APP_ENV=development)
QA_DEV_SIGNOFF_STATUS=
# Set to "completed" or "missing" to simulate QA sign-off in development

# L3 approval notifications
PORTAL_BASE_URL=http://localhost:5173
L3_MANAGER_EMAIL=

# Gmail SMTP (L3 and RM approval notifications)
MAIL_ENABLED=false
GMAIL_USER=
# 16-character Google App Password — NOT your regular Gmail password
# Create at https://myaccount.google.com/apppasswords (2-Step Verification required)
GMAIL_APP_PASSWORD=
# Optional display/from override (defaults to GMAIL_USER)
MAIL_FROM=
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
