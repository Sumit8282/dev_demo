# Backend API base URL (leave empty to use Vite dev proxy at /api)



VITE_API_BASE_URL=http://localhost:8000







# Microsoft Entra ID (Azure AD) — SPA app registration



VITE_AZURE_AD_CLIENT_ID=your-client-id



VITE_AZURE_AD_TENANT_ID=your-tenant-id



# Must match a redirect URI registered under "Single-page application" in Azure AD



VITE_AZURE_AD_REDIRECT_URI=http://localhost:5173



VITE_AZURE_AD_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login

